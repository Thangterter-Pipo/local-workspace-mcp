# ==============================================================================
# Local Workspace MCP configuration
# Cross-platform MCP server for Windows, macOS, and Linux
# Recommended ChatGPT connector name: Local Workspace
# ==============================================================================

# Canonical variables use WORKSPACE_MCP_*. Existing FLOW_VEO_MCP_* values remain
# supported as lower-priority fallbacks for backward compatibility.

# --- REQUIRED ---
# Bearer token used to authenticate MCP clients.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKSPACE_MCP_API_KEY=change-me-to-a-long-random-string

# Owner PIN entered on /consent during ChatGPT OAuth connection.
WORKSPACE_MCP_CONSENT_PIN=change-me-pin-123456

# --- NETWORK ---
WORKSPACE_MCP_HOST=127.0.0.1
WORKSPACE_MCP_PORT=3080

# Public HTTPS origin used for OAuth discovery and callbacks.
# PUBLIC_URL takes precedence; WORKSPACE_MCP_BASE_URL is the product-prefixed form.
PUBLIC_URL=https://mcp.yourdomain.com
# WORKSPACE_MCP_BASE_URL=https://mcp.yourdomain.com

# --- WORKSPACE ROOT ---
# Directory exposed by the server. If omitted, the project directory is used.
# Windows example: E:\Projects
# macOS/Linux example: /Users/username/projects
WORKSPACE_MCP_ROOT=
# ALLOWED_ROOTS remains supported as a compatibility alias.

# --- OPTIONAL SSH REVERSE TUNNEL ---
# WORKSPACE_MCP_SSH_HOST=my-vps-server

# --- LIMITS ---
COMMAND_TIMEOUT_SECONDS=120
MAX_COMMAND_OUTPUT_MB=50
MAX_FILE_READ_MB=100
UVICORN_KEEP_ALIVE=20

# --- OPTIONAL OAUTH SETTINGS ---
# WORKSPACE_MCP_OAUTH_REDIRECT_PREFIXES=
# WORKSPACE_MCP_ALLOW_LOCAL_OAUTH=0

# Legacy fallback examples (do not set both old and new names):
# FLOW_VEO_MCP_API_KEY=
# FLOW_VEO_MCP_CONSENT_PIN=
# FLOW_VEO_MCP_HOST=
# FLOW_VEO_MCP_PORT=
# FLOW_VEO_MCP_BASE_URL=
# FLOW_VEO_MCP_ROOT=
# FLOW_VEO_MCP_SSH_HOST=
